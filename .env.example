NEXT_PUBLIC_APP_URL=https://manora.tj
NEXT_PUBLIC_API_URL=https://back.manora.tj/api
NEXT_PUBLIC_STORAGE_URL=https://back.manora.tj/storage
# Public residential v2 UI. The approved first release is enabled; rebuild with false only for rollback.
# Does not disable the compatible API, management tools or internal CRM receipt storage.
NEXT_PUBLIC_RESIDENTIAL_V2_ENABLED=true
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_COOKIE_DOMAIN=.manora.tj
NEXT_PUBLIC_COOKIE_SECURE=true
NEXT_PUBLIC_GA_ID=
# Set true only after reviewing GA settings and disabling all automatic enhanced measurement.
NEXT_PUBLIC_GA_MANUAL_EVENTS_ONLY=false
NEXT_PUBLIC_DEBUG_AUTH=false
NEXT_PUBLIC_DEBUG_MIDDLEWARE=false
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
